# dailytally2 ローカル開発用の環境変数とシークレット
# 本番の非秘匿値は wrangler.toml、秘匿値は wrangler secret put で設定する。
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
SESSION_SECRET=
TENDO_ACCOUNT=
TENDO_PASSWORD=
RESEND_API_KEY=
REPORT_NOTIFY_FROM=
REPORT_REMOTE_SUBMIT=false
# osystem-masters の URL。ローカル開発時は別ポートで上げた dev server を指す。
# 例: MASTERS_URL=http://localhost:8787
MASTERS_URL=
